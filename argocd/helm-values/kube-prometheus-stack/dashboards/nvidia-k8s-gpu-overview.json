          "text": "prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "node_regex",
        "label": "k8s nodes",
        "type": "constant",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2,
        "skipUrlSync": true,
        "description": "Regex over hostname of Kubernetes nodes"
      },
      {
        "name": "gpu_type",
        "label": "GPU type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL{hostname=~\"$node_regex\"}, modelName)",
        "query": {
          "qryType": 1,
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{hostname=~\"$node_regex\"}, modelName)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/^(?<value>NVIDIA (?:GeForce )?(?<text>.+))$/",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 1,
        "sort": 1,
        "skipUrlSync": false
      }
    ]
  },
